<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>لوحة البائع - Mini Marketplace</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 15px;
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      color: #222;
    }

    .container {
      max-width: 900px;
      margin: auto;
    }

    .card {
      background: white;
      padding: 20px;
      margin-bottom: 20px;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    h1, h2 {
      text-align: center;
    }

    input, select, textarea, button {
      width: 100%;
      padding: 12px;
      margin: 6px 0;
      border-radius: 8px;
      border: 1px solid #ccc;
      font-size: 16px;
      box-sizing: border-box;
    }

    button {
      background: #222;
      color: white;
      border: none;
      cursor: pointer;
    }

    .logout {
      background: #c62828;
    }

    .product {
      border: 1px solid #ddd;
      padding: 15px;
      margin-top: 12px;
      border-radius: 10px;
      background: #fafafa;
    }

    .product img {
      width: 100%;
      max-width: 250px;
      height: 180px;
      object-fit: cover;
      border-radius: 8px;
    }

    .hidden {
      display: none;
    }

    .message {
      text-align: center;
      font-weight: bold;
      margin: 10px 0;
    }

    @media (max-width: 600px) {
      body {
        padding: 10px;
      }

      .card {
        padding: 15px;
      }
    }
  </style>
</head>

<body>

<div class="container">

  <!-- تسجيل الدخول -->
  <div id="loginScreen" class="card">
    <h2>🔐 تسجيل دخول البائع</h2>

    <input id="sellerEmail" type="email" placeholder="البريد الإلكتروني">

    <input id="sellerPassword" type="password" placeholder="كلمة المرور">

    <button onclick="sellerLogin()">دخول</button>

    <div id="loginMessage" class="message"></div>
  </div>


  <!-- لوحة البائع -->
  <div id="sellerPanel" class="hidden">

    <div class="card">
      <h1>🧑‍💼 لوحة البائع</h1>

      <h2>أهلاً بك <span id="sellerName"></span> 👋</h2>

      <p>
        البريد:
        <strong id="sellerEmailDisplay"></strong>
      </p>

      <button class="logout" onclick="logoutSeller()">
        🚪 تسجيل الخروج
      </button>
    </div>


    <!-- إضافة منتج -->
    <div class="card">

      <h2>➕ إضافة منتج</h2>

      <input id="productName" placeholder="اسم المنتج">

      <input id="productPrice" type="number" placeholder="السعر">

      <select id="productCategory">
        <option value="electronics">إلكترونيات</option>
        <option value="watches">ساعات</option>
        <option value="accessories">إكسسوارات</option>
        <option value="clothes">ملابس</option>
        <option value="other">أخرى</option>
      </select>

      <textarea
        id="productDescription"
        placeholder="وصف المنتج"
        rows="4"
      ></textarea>

      <input
        type="file"
        id="productImage"
        accept="image/*"
      >

      <button onclick="addSellerProduct()">
        ➕ إضافة المنتج
      </button>

      <div id="addProductMessage" class="message"></div>

    </div>


    <!-- المنتجات -->
    <div class="card">

      <h2>📦 منتجاتي</h2>

      <div id="productsMessage" class="message">
        جاري تحميل المنتجات...
      </div>

      <div id="productsList"></div>

    </div>

  </div>

</div>


<script>

const API_URL = "http://127.0.0.1:3000";

let currentSeller = null;


// تسجيل الدخول
async function sellerLogin() {

  const email =
    document.getElementById("sellerEmail").value.trim();

  const password =
    document.getElementById("sellerPassword").value;

  const message =
    document.getElementById("loginMessage");

  if (!email || !password) {
    message.textContent =
      "يرجى إدخال البريد وكلمة المرور";
    return;
  }

  message.textContent =
    "جاري تسجيل الدخول...";

  try {

    const response = await fetch(
      API_URL + "/seller-login",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          email: email,
          password: password
        })
      }
    );

    const data = await response.json();

    if (!response.ok || !data.success) {
      message.textContent =
        data.message || "فشل تسجيل الدخول";
      return;
    }

    currentSeller = data.seller;

    localStorage.setItem(
      "currentSeller",
      JSON.stringify(currentSeller)
    );

    showSellerPanel();

  } catch (error) {

    console.error(error);

    message.textContent =
      "تعذر الاتصال بالسيرفر ❌";
  }
}


// عرض لوحة البائع
function showSellerPanel() {

  if (!currentSeller) {
    return;
  }

  document
    .getElementById("loginScreen")
    .classList.add("hidden");

  document
    .getElementById("sellerPanel")
    .classList.remove("hidden");

  document
    .getElementById("sellerName")
    .textContent = currentSeller.name;

  document
    .getElementById("sellerEmailDisplay")
    .textContent = currentSeller.email;

  loadSellerProducts();
}


// تحميل منتجات البائع
async function loadSellerProducts() {

  const list =
    document.getElementById("productsList");

  const message =
    document.getElementById("productsMessage");

  message.textContent =
    "جاري تحميل المنتجات...";

  try {

    const response = await fetch(
      API_URL +
      "/products?seller_id=" +
      encodeURIComponent(currentSeller.id)
    );

    const products = await response.json();

    list.innerHTML = "";

    if (!Array.isArray(products)) {
      message.textContent =
        products.message || "حدث خطأ";
      return;
    }

    if (products.length === 0) {
      message.textContent =
        "لا توجد لديك منتجات حاليًا";
      return;
    }

    message.textContent =
      "عدد المنتجات: " + products.length;

    products.forEach(product => {

      const div =
        document.createElement("div");

      div.className = "product";

      let imageHTML = "";

      if (product.image) {
        imageHTML =
          `<img src="${product.image}" alt="">`;
      }

      div.innerHTML = `
        ${imageHTML}
        <h3>${product.name}</h3>
        <p>💰 السعر: <strong>${product.price}</strong></p>
        <p>🏷️ التصنيف: ${product.category || "غير محدد"}</p>
        <p>📝 الوصف: ${product.description || "لا يوجد وصف"}</p>
      `;

      list.appendChild(div);

    });

  } catch (error) {

    console.error(error);

    message.textContent =
      "حدث خطأ أثناء تحميل المنتجات ❌";
  }
}


// إضافة منتج
async function addSellerProduct() {

  const name = document.getElementById("productName").value.trim();
  const price = document.getElementById("productPrice").value;
  const category = document.getElementById("productCategory").value;
  const description = document.getElementById("productDescription").value.trim();
  const imageInput = document.getElementById("productImage");
  const message = document.getElementById("addProductMessage");

  if (!name || price === "") {
    message.textContent = "يرجى إدخال اسم المنتج والسعر";
    return;
  }

  if (!currentSeller) {
    message.textContent = "لم يتم تسجيل دخول البائع";
    return;
  }

  message.textContent = "جاري إضافة المنتج...";

  try {

    let image = "";

    if (imageInput.files.length > 0) {

      message.textContent = "جاري رفع الصورة...";

      const formData = new FormData();
      formData.append("image", imageInput.files[0]);

      const uploadResponse = await fetch(
        API_URL + "/upload",
        {
          method: "POST",
          body: formData
        }
      );

      const uploadData = await uploadResponse.json();

      if (!uploadResponse.ok || !uploadData.success) {
        message.textContent =
          uploadData.message || "فشل رفع الصورة";
        return;
      }

      image = uploadData.image;
    }

    message.textContent = "جاري إضافة المنتج...";

    const response = await fetch(
      API_URL + "/products",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          name: name,
          price: Number(price),
          category: category,
          description: description,
          image: image,
          seller_id: currentSeller.id
        })
      }
    );

    const data = await response.json();

    if (!response.ok || !data.success) {
      message.textContent =
        data.message || "تعذر إضافة المنتج";
      return;
    }

    message.textContent =
      "تمت إضافة المنتج بنجاح ✅";

    document.getElementById("productName").value = "";
    document.getElementById("productPrice").value = "";
    document.getElementById("productDescription").value = "";
    document.getElementById("productImage").value = "";

    await loadSellerProducts();

  } catch (error) {

    console.error(error);

    message.textContent =
      "حدث خطأ أثناء إضافة المنتج";
  }
}


// تسجيل الخروج
function logoutSeller() {

  localStorage.removeItem("currentSeller");

  currentSeller = null;

  document
    .getElementById("sellerPanel")
    .classList.add("hidden");

  document
    .getElementById("loginScreen")
    .classList.remove("hidden");

  document.getElementById("sellerEmail").value = "";
  document.getElementById("sellerPassword").value = "";

  document.getElementById("loginMessage").textContent = "";
}


// استعادة الجلسة
function restoreSellerSession() {

  const saved =
    localStorage.getItem("currentSeller");

  if (!saved) {
    return;
  }

  try {

    currentSeller = JSON.parse(saved);

    if (
      currentSeller &&
      currentSeller.id
    ) {
      showSellerPanel();
    }

  } catch (error) {

    localStorage.removeItem("currentSeller");
  }
}


restoreSellerSession();

</script>

</body>
</html>
